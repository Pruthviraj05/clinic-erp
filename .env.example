# Clinicore — environment variables
#
# Copy to `.env.local` and fill in. NEVER commit the real file — `.env*` is
# gitignored (this template is the one exception).
#
# The same four variables must be set in Vercel → Project Settings →
# Environment Variables for the deployed site.

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# "demo"    → in-memory demo dataset (no database needed; resets on restart)
# "mongodb" → MongoDB storage adapter — the production setting
NEXT_PUBLIC_DATA_MODE=mongodb

# Required when NEXT_PUBLIC_DATA_MODE=mongodb.
# NOTE: the SRV form (mongodb+srv://) fails behind some networks with
# "querySrv ECONNREFUSED". If that happens, use the direct shard-host form
# from Atlas → Connect → "I'll use my driver" → Node.js → older version.
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/clinicore?retryWrites=true&w=majority"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# "credentials" → email + password form — the production setting
# "demo"        → role-switch login with NO password. Development only:
#                 it also enables /dev-login, which hands out an admin
#                 session to anyone who opens the URL.
NEXT_PUBLIC_AUTH_MODE=credentials

# Signs the session cookie so it cannot be forged. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be identical everywhere the app runs.
# SESSION_SECRET="<64-character hex string>"

# ---------------------------------------------------------------------------
# First-run setup (once MONGODB_URI is set)
# ---------------------------------------------------------------------------
#   node --env-file=.env.local scripts/ensure-indexes.mjs   # indexes first
#   node --env-file=.env.local scripts/seed-mongodb.mjs     # then seed data
#
# Seeds admin@gmail.com / Test@12345 — change the password after first login.

# ---------------------------------------------------------------------------
# Prisma (schema kept as the ER reference only — not used at runtime)
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://user:pass@localhost:5432/clinic_erp?schema=public"
